---
import { CHECKOUT_PATH_REDIRECTS } from '../../config/checkout-redirects.mjs';

/** Static checkout hops — required on CDN hosts without Astro middleware. */
export function getStaticPaths() {
  const slugs = [
    ...new Set(
      [...CHECKOUT_PATH_REDIRECTS.keys()]
        .map((p) => p.replace(/^\/go\//, '').replace(/\/$/, ''))
        .filter(Boolean),
    ),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const path = `/go/${slug}/`;
const destination =
  CHECKOUT_PATH_REDIRECTS.get(path) ??
  CHECKOUT_PATH_REDIRECTS.get(`/go/${slug}`) ??
  null;

if (!destination) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to secure checkout</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={destination} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <p>
      Redirecting to checkout…
      <a href={destination} rel="sponsored noopener noreferrer">Continue if you are not redirected</a>.
    </p>
  </body>
</html>
