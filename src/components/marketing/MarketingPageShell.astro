---
import Breadcrumbs from '../Breadcrumbs.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import Icon from '../icons/Icon.astro';
import type { BreadcrumbItem } from '../../utils/schema';
import { PRIMARY_CHECKOUT_PATH } from '../../config/checkout';
import { SITE_CONTENT_LAST_UPDATED } from '../../config/brand';

import type { MarketingSection, MarketingFaq, RelatedLink } from '../../data/marketing/types';

interface Props {
  h1: string;
  lead: string;
  breadcrumbs: BreadcrumbItem[];
  lastUpdated?: string;
  quickAnswer?: string[];
  sections: MarketingSection[];
  faqs?: MarketingFaq[];
  relatedLinks?: RelatedLink[];
  primaryKeyword?: string;
}

const {
  h1,
  lead,
  breadcrumbs,
  lastUpdated = SITE_CONTENT_LAST_UPDATED,
  quickAnswer,
  sections,
  faqs = [],
  relatedLinks = [],
} = Astro.props;

const formattedDate = new Date(lastUpdated).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="py-8 md:py-12">
  <div class="section-shell max-w-3xl">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 space-y-4 text-left">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        Last updated: <time datetime={lastUpdated}>{formattedDate}</time>
      </p>
      <h1 class="font-[family-name:var(--font-heading)] text-3xl font-bold leading-tight md:text-4xl">{h1}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{lead}</p>
    </header>

    {
      quickAnswer && quickAnswer.length > 0 && (
        <aside
          class="mt-8 rounded-xl border bg-muted/20 p-5 text-left"
          aria-label="Quick answer"
        >
          <p class="text-xs font-bold uppercase tracking-wider text-primary">Quick answer</p>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-foreground">
            {quickAnswer.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      <Button as="a" href={PRIMARY_CHECKOUT_PATH} variant="primary" size="sm" rel="sponsored noopener">
        Buy now
        <Icon name="arrowRight" size={16} />
      </Button>
      <Button as="a" href="/pricing/" variant="outline" size="sm">
        View pricing
      </Button>
    </div>

    <Prose class="mt-10 max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>

    {
      faqs.length > 0 && (
        <section class="mt-12 border-t border-border pt-10" aria-labelledby="page-faq-heading">
          <h2 id="page-faq-heading" class="text-2xl font-bold">
            Frequently asked questions
          </h2>
          <div class="mt-6 space-y-3">
            {faqs.map((item) => (
              <details class="group rounded-xl border border-border bg-card px-4 py-3 open:pb-4">
                <summary class="cursor-pointer list-none font-semibold text-foreground marker:content-none [&::-webkit-details-marker]:hidden">
                  {item.q}
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedLinks.length > 0 && (
        <nav class="mt-12 rounded-xl border border-dashed border-border p-5" aria-label="Related pages">
          <h2 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Keep reading</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {relatedLinks.map((link) => (
              <li>
                <a class="text-primary underline-offset-4 hover:underline" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="mt-12 flex flex-wrap gap-3 border-t border-border pt-8">
      <Button as="a" href={PRIMARY_CHECKOUT_PATH} variant="primary" rel="sponsored noopener">
        Buy Arc Raiders cheats
      </Button>
      <Button as="a" href="/faq/" variant="outline">
        Full FAQ
      </Button>
    </div>
  </div>
</article>
